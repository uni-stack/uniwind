{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "noUncheckedIndexedAccess": false,
        "rootDir": ".",
        "types": ["jest"]
    },
    "include": [
        "./src",
        "./types.d.ts",
        "./tests"
    ],
    "exclude": [
        "./tests/type-test"
    ]
}
